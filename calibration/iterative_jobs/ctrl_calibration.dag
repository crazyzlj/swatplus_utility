# ctrl_calibration.dag
# Main iterative workflow for auto-calibration
# This DAG will be submitted first by the users using `condor_submit_dag -insert_env "iter_index=0" ctrl_calibration.dag`.
#  During the calibration process, this DAG will be iteratively submitted by `resubmit_if_needed.sh`

# --- Step 1: Prepare next generation ---
JOB PREPARE_NEXT_GEN ctrl_calibration_generate_job.sub
VARS PREPARE_NEXT_GEN iter_index="$ENV(iter_index)"

# --- Step 2: Run current generation workers ---
SUBDAG EXTERNAL RUN_CURRENT_GEN worker_jobs_current.dag

# --- Step 3: Gather results and check ---
JOB GATHER_CHECK_CONTINUE ctrl_calibration_analyze_job.sub
VARS GATHER_CHECK_CONTINUE iter_index="$ENV(iter_index)"
VARS GATHER_CHECK_CONTINUE nextiter_index="$ENV(nextiter_index)"

# --- Step 4: Control loop ---
SCRIPT POST GATHER_CHECK_CONTINUE resubmit_if_needed.sh

# --- Dependencies ---
PARENT PREPARE_NEXT_GEN CHILD RUN_CURRENT_GEN
PARENT RUN_CURRENT_GEN CHILD GATHER_CHECK_CONTINUE